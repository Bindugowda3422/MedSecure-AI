# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only. Never expose to the client. Used for admin writes / RLS bypass in trusted server routes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Blockchain ----
# Local Hardhat node default: http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Server-only signer key. NEVER commit or expose to the browser.
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
# Optional, only needed for Sepolia deployment via hardhat.config.ts
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# ---- AI ----
# Gemini API key (server-only) - or swap provider in lib/ai/assistant.ts
AI_API_KEY=
AI_PROVIDER=gemini

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
